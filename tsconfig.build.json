{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["server", "shared", "client"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "client/main.ts",
    "client/demo",
    "**/*.test.ts",
    "**/*.integration.test.ts"
  ]
}
